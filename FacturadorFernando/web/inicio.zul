<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/landing/signin.css?v28"?>

<?script src="/js/icon.js"?>
<?script src="./js/inicio.js?v23"?>

<?link rel="icon" type="image/x-icon" href="/imagenes/logo/paybillslogo.png"?>
<?page title="Facturacion electrónica" contentType="text/html;charset=UTF-8"?>

<zk>
    <div class="login_container" id="loginWin" apply="com.ec.controlador.LoginController">
        <div class="tf-header">
            <image src="/imagenes/logo/confirma-actura-fondo.png?v2" class="tf-brand-logo" />
            <div class="tf-header-actions">
                <span class="tf-btn tf-btn-teal tf-btn-sm login_btn" id="btnMostrarLogin">INICIAR SESIÓN</span>
                <button class="tf-btn tf-btn-orange tf-btn-sm" id="btnRegistra">REGISTRO</button>
            </div>
        </div>

        <div class="tf-hero">
            <div class="tf-badge">
                <span class="tf-badge-icon">⚡</span>
                <span class="tf-badge-text">FACTURACIÓN ELECTRÓNICA</span>
            </div>
            <span class="tf-title">A un <span class="tf-click">click</span> de organizar tu empresa</span>
            <span class="tf-subtitle">Optimiza tu facturación con la plataforma más ágil y segura. Diseñada especialmente para emprendedores, profesionales independientes y medianas empresas.</span>

            <div class="tf-hero-actions">
                <button class="tf-btn tf-btn-orange tf-btn-lg" id="btnComenzarAhora">COMENZAR AHORA</button>
                <button class="tf-btn tf-btn-teal tf-btn-lg" id="btnAccesoClientes">ACCESO CLIENTES</button>
            </div>
        </div>

        <div class="tf-footer">
            <span class="tf-copy">© 2026 tuf4ctura.com — Todos los derechos reservados.</span>
            <a class="tf-whatsapp" href="https://wa.me/593999226274" target="_blank">
                <span class="fa-brands fa-whatsapp"></span>
                <span>099 9226 274</span>
            </a>
        </div>

        <div class="container_wrapper_signin_root" id="panelLogin">
            <div class="wrapper_signin">
                <span class="tf-modal-close" id="btnCerrarLogin">×</span>
                <span class="title">Inicia sesión</span>
                <span class="subtitle">Administrar tus facturas nunca ha sido tan facil!</span>

                <div class="wrapper_all_inputs">
                    <div class="wrapper_input">
                        <span class="fas fa-user icon"></span>
                        <textbox
                            type="text"
                            class="input"
                            id="account"
                            placeholder="Usuario"
                        />
                    </div>
                    <div class="wrapper_input">
                        <span class="fas fa-lock icon"></span>
                        <textbox
                            type="password"
                            placeholder="Contraseña"
                            class="input input_password"
                            id="password"
                        />
                        <span class="fa-solid fa-eye icon_eye icon"></span>
                    </div>
                </div>

                <div class="tf-modal-links">
                    <span class="forgot_text" id="linkOlvideContrasena">Olvidaste tu contraseña?</span>
                    <span class="tf-register-link" id="linkRegistroPopup">Realiza tu registro aquí</span>
                </div>

                <div class="wrapper_buttons">
                    <button class="btn btn_sign tf-btn tf-btn-teal" id="buttonEntrar">Ingresar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="wrapper_loading loading_inicio">
        <div class="lds-dual-ring"></div>
    </div>
</zk>
